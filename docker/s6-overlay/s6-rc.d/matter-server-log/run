#!/usr/bin/env bash
# Logger for the matter-server service. s6 pipes matter-server's stdout into here;
# s6-log writes rotated, timestamped files to /matter2mqtt-run/logs/matter-server/current.
# All service logs live under /matter2mqtt-run/logs (in the bind-mounted run dir) so
# they show on the host.
#   n5        keep 5 rotated files
#   s10000000 rotate at ~10 MB
set -euo pipefail

# TEE_TO_CONTAINER=1 also copies each line to the container's stdout, rewritten by to_container() as
# "<prio>matter-server: message". The log file always gets the line unchanged. A leading <N> is a
# syslog priority: journald honours it when it captures the container's output, so under
# matter2mqtt.service `journalctl -u matter2mqtt -p warning` works. To flip this in a
# running container, edit /run/service/matter-server-log/run.user, then
# `/command/s6-svc -r /run/service/matter-server-log`: that restarts only this logger, and s6
# holds the pipe from matter-server, so no lines are lost.
TEE_TO_CONTAINER=1

LOGDIR=/matter2mqtt-run/logs/matter-server
mkdir -p "$LOGDIR"                     # make the dir ourselves so the symlink has a home
ln -sf current "$LOGDIR/matter-server.log"  # stable .log handle to the live log; survives rotation

to_container() {
    exec mawk -W interactive '
        # matter-server logs "<date> <time>.<ms> (<thread>) LEVEL [<logger>] message", always
        # with ANSI colours (coloredlogs does not check for a tty). Drop the colours and the
        # timestamp (journald has its own). Lines without a level are continuations
        # (tracebacks, multi-line messages) and keep the priority of the previous line.
        BEGIN { p = 6; esc = sprintf("%c", 27) }
        {
            gsub(esc "\\[[0-9;]*m", "")
            if (sub(/^\[matter-server\] /, "")) p = 6
            if (match($0, / (CRITICAL|ERROR|WARNING|INFO|DEBUG|VERBOSE|CHIP_[A-Z]+|chip_[a-z]+) \[/)) {
                l = toupper(substr($0, RSTART + 1, RLENGTH - 3))
                p = (l == "CRITICAL") ? 2 : (l ~ /ERROR/) ? 3 : (l == "WARNING") ? 4 : \
                    (l == "INFO" || l == "CHIP_PROGRESS") ? 6 : 7
                sub(/^[0-9][0-9-]* [0-9][0-9:.,]* /, "")
            }
            print "<" p ">matter-server: " $0
            fflush()
        }
    '
}

if [ "$TEE_TO_CONTAINER" = 1 ]; then
    # The trailing "1" makes s6-log forward every line to its stdout: to_container.
    exec s6-log -b n5 s10000000 "$LOGDIR" 1 > >(to_container)
fi
exec s6-log -b n5 s10000000 "$LOGDIR"
