#!/usr/bin/env bash
# Logger for the dbus service. s6 pipes dbus's stdout into here; s6-log writes
# rotated, timestamped files to /matter2mqtt-run/logs/dbus/current. All service logs
# live under /matter2mqtt-run/logs (in the bind-mounted run dir) so they show on the host.
#   n5       keep 5 rotated files
#   s1000000 rotate at ~1 MB
set -euo pipefail

# TEE_TO_CONTAINER=1 also copies each line to the container's stdout, rewritten by to_container() as
# "<prio>dbus: message". The log file always gets the line unchanged. A leading <N> is a
# syslog priority: journald honours it when it captures the container's output, so under
# matter2mqtt.service `journalctl -u matter2mqtt -p warning` works. To flip this in a
# running container, edit /run/service/dbus-log/run.user, then
# `/command/s6-svc -r /run/service/dbus-log`: that restarts only this logger, and s6
# holds the pipe from dbus, so no lines are lost.
TEE_TO_CONTAINER=1

LOGDIR=/matter2mqtt-run/logs/dbus
mkdir -p "$LOGDIR"                     # make the dir ourselves so the symlink has a home
ln -sf current "$LOGDIR/dbus.log"     # stable .log handle to the live log; survives rotation

to_container() {
    exec mawk -W interactive '
        # dbus-daemon has no level markers; everything is info.
        {
            print "<6>dbus: " $0
            fflush()
        }
    '
}

if [ "$TEE_TO_CONTAINER" = 1 ]; then
    # The trailing "1" makes s6-log forward every line to its stdout: to_container.
    exec s6-log -b n5 s1000000 "$LOGDIR" 1 > >(to_container)
fi
exec s6-log -b n5 s1000000 "$LOGDIR"
