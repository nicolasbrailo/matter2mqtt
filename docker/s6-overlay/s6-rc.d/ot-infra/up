bash -c "
  set -euo pipefail
  mkdir -p /mt2mqtt-run/logs
  exec >> /mt2mqtt-run/logs/ot-infra.log 2>&1
  # Under --network none the container has only loopback, and it may come up
  # DOWN. matter-server binds 127.0.0.1:5580 (and matter-ws-check.py dials it),
  # so ensure lo is up before anything needs it. Idempotent if already up.
  echo '[ot-infra] bringing loopback up...'
  ip link set lo up
  echo '[ot-infra] creating ot-infra dummy interface...'
  ip link show ot-infra >/dev/null 2>&1 || ip link add ot-infra type dummy
  ip link set ot-infra up
  ip -6 addr replace fe80::1/64 dev ot-infra
  echo '[ot-infra] done.'
"
