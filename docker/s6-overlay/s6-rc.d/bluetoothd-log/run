#!/usr/bin/env bash
# Logger for the bluetoothd service. s6 pipes bluetoothd's stdout into here;
# s6-log writes rotated, timestamped files to /matter2mqtt-run/logs/bluetoothd/current.
# All service logs live under /matter2mqtt-run/logs (in the bind-mounted run dir) so
# they show on the host.
#   n5       keep 5 rotated files
#   s1000000 rotate at ~1 MB
set -euo pipefail

# TEE_TO_CONTAINER=1 also copies each line to the container's stdout, rewritten by to_container() as
# "<prio>bluetoothd: message". The log file always gets the line unchanged. A leading <N> is a
# syslog priority: journald honours it when it captures the container's output, so under
# matter2mqtt.service `journalctl -u matter2mqtt -p warning` works. To flip this in a
# running container, edit /run/service/bluetoothd-log/run.user, then
# `/command/s6-svc -r /run/service/bluetoothd-log`: that restarts only this logger, and s6
# holds the pipe from bluetoothd, so no lines are lost.
TEE_TO_CONTAINER=0

LOGDIR=/matter2mqtt-run/logs/bluetoothd
mkdir -p "$LOGDIR"                     # make the dir ourselves so the symlink has a home
ln -sf current "$LOGDIR/bluetoothd.log"  # stable .log handle to the live log; survives rotation

to_container() {
    exec mawk -W interactive '
        # bluetoothd runs with -d: its debug lines name their source
        # ("bluetoothd[pid]: src/main.c:parse_config() ...") and become debug priority; its
        # other lines already carry "bluetoothd[pid]: " and are info. Lines from the run
        # script itself, "[bluetoothd] ...", get a "bluetoothd: " prefix. Off by default: in
        # debug mode it writes thousands of lines a minute.
        {
            p = ($0 ~ /^bluetoothd\[[0-9]+\]: [^ ]+\.c:[^ ]+\(\)/) ? 7 : 6
            if ($0 !~ /^bluetoothd\[[0-9]+\]: /) {
                sub(/^\[bluetoothd\] /, "")
                $0 = "bluetoothd: " $0
            }
            print "<" p ">" $0
            fflush()
        }
    '
}

if [ "$TEE_TO_CONTAINER" = 1 ]; then
    # The trailing "1" makes s6-log forward every line to its stdout: to_container.
    exec s6-log -b n5 s1000000 "$LOGDIR" 1 > >(to_container)
fi
exec s6-log -b n5 s1000000 "$LOGDIR"
