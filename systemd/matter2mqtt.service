# The matter2mqtt container, run in the foreground so systemd supervises it and its output
# lands in the journal. Not using docker's --restart policy on purpose: docker would start it
# without waiting for the proxies, and would reuse the /dev/ttyACMx resolved at create time
# even if the dongle re-enumerates. Here the dongle is resolved from its by-id name on every
# start.
[Unit]
Description=matter2mqtt container (OTBR + matter-server + MQTT bridge)
Requires=docker.service
After=docker.service matter2mqtt-mqtt-proxy.socket matter2mqtt-bluez-proxy.service
Wants=matter2mqtt-mqtt-proxy.socket matter2mqtt-bluez-proxy.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f matter2mqtt
ExecStart=/bin/sh -c '\
  rcp=$$(readlink -e /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*) \
    || { echo "RCP dongle not found under /dev/serial/by-id" >&2; exit 1; }; \
  exec /usr/bin/docker run --rm --name matter2mqtt \
    --network none \
    -v @RUNDIR@:/matter2mqtt-run \
    -v /run/matter2mqtt-bluez-proxy:/matter2mqtt-run/bluez \
    --device "$$rcp":/dev/ttyACM0 \
    --device /dev/net/tun --cap-add NET_ADMIN \
    @IMAGE@'
# A stop normally takes ~4s, but s6-overlay won't act on SIGTERM until startup is done, and
# startup can block for up to otbr-agent-net's timeout-up (150s) while waiting to attach to
# the mesh. Docker's default 10s would SIGKILL the container mid-startup (exit 137, unit
# marked failed), so give it 180s; TimeoutStopSec has to outlast that or systemd kills
# ExecStop first.
ExecStop=/usr/bin/docker stop -t 180 matter2mqtt
TimeoutStopSec=200
Restart=always
RestartSec=5
# Container output arrives as "<prio>service: message" from the s6 loggers that have
# TEE_TO_CONTAINER=1; journald turns the <prio> into the entry's priority, so
# `journalctl -u matter2mqtt -p err` works. Without this the identifier would be "sh".
SyslogIdentifier=matter2mqtt

[Install]
WantedBy=multi-user.target
